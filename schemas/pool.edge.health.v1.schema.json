{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pool.edge.health.v1",
  "title": "Edge lifecycle/health event",
  "description": "Periodic edge heartbeat and boot/shutdown markers for central observability.",
  "type": "object",
  "required": [
    "schema", "event_id", "edge_id", "edge_boot_id", "edge_seq",
    "status", "node_healthy", "sessions", "template_height", "at_ms"
  ],
  "properties": {
    "schema": { "const": "pool.edge.health.v1" },
    "event_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "edge_id": { "type": "string", "maxLength": 64 },
    "edge_boot_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "edge_seq": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["boot", "running", "shutdown", "unhealthy"] },
    "node_healthy": { "type": "boolean" },
    "sessions": { "type": "integer", "minimum": 0 },
    "template_height": { "type": ["integer", "null"], "minimum": 0 },
    "at_ms": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
