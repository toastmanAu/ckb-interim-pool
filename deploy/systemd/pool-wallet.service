[Unit]
Description=CKB Interim Pool — treasury reconciliation and capped payouts
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=pool-wallet
Group=pool-wallet
WorkingDirectory=/opt/wyltek-pool
Environment=POOL_DB_URL=postgres://pool:CHANGEME@127.0.0.1:5432/pooltest
Environment=POOL_NODE_RPC=http://127.0.0.1:8114
Environment=POOL_INDEXER_URL=http://127.0.0.1:8114
Environment=POOL_WALLET_KEY=/etc/wyltek-pool/payout.privkey
Environment=POOL_WALLET_EXPECTED_ADDRESS=
Environment=POOL_WALLET_NETWORK=ckb
Environment=POOL_WALLET_COLD_ADDRESS=
Environment=POOL_WALLET_ARMED=0
Environment=POOL_WALLET_DRY_RUN=0
Environment=POOL_WALLET_FLOAT_SHANNONS=500000000000
Environment=POOL_WALLET_MAX_BATCH_SHANNONS=200000000000
Environment=POOL_WALLET_MAX_DAILY_SHANNONS=1000000000000
Environment=POOL_MIN_PAYOUT_SHANNONS=100000000000
# Dust sweep: pay a stranded sub-minimum balance once its miner has taken no
# credit for this many days (a changed payout address strands the old one).
Environment=POOL_DUST_INACTIVE_DAYS=3
# Forfeit balances too small to form a cell at all, after this many days of
# dormancy. 0 = never. Moving miner funds to the pool is custodial
# confiscation: put it in the pool terms before raising this.
Environment=POOL_DUST_FORFEIT_DAYS=0
Environment=POOL_WALLET_TICK_MS=300000
Environment=POOL_WALLET_CONFIRMATIONS=20
Environment=POOL_WALLET_METRICS_PORT=9102
ExecStart=/usr/bin/node src/wallet/main.js
Restart=always
RestartSec=5
MemoryHigh=256M
MemoryMax=512M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryDenyWriteExecute=yes
LimitCORE=0

[Install]
WantedBy=multi-user.target
